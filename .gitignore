# ==============================================================================
# Git Ignore Configuration - supeRR_selector
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Secrets, keys, and credentials
*.key
*.pem
*.token
credentials.json
api_key*
secrets*

# IDE & OS temporary files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Temporary scratch binaries and test renders
scratch/*.pdf
scratch/*.png
scratch/*.html
scratch/pdf_pages_*/

# Large Raw and Intermediate Delivery-Level Datasets (>40 MB)
# Excluded from version control due to repository size and privacy best practices.
data/
*.parquet
outputs/step_4_pressure_pipeline/delivery_pressure_v2.csv
outputs/step_4_pressure_pipeline/delivery_pressure_v3.csv
outputs/step_4_pressure_pipeline/manual_delivery_test_cases.csv
outputs/step_4_pressure_pipeline/*.parquet
outputs/step_5_player_level_dataset/
scratch/
